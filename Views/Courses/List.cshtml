<div id="CourseListPanel" class="CourseListLayout">
    <!-- Periodicaly refreshed -->
</div>

@section Scripts {
    <script>

        let courseListARP = null;

        $(() => {
            newSession(600);
            courseListARP =
                new AutoRefreshedPanel(
                    "CourseListPanel",
                    "/Courses/GetCourses",
                    5,
                    courseListPostRefresh);

            function courseListPostRefresh() { }
        })
    </script>
}
