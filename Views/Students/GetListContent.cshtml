@model IEnumerable <Models.Student>
@{
    var session = Models.Session.Instance.Students;
    var groups = Model.Where(s => s.Caption.ToLower().Contains(session.SearchString))
        .OrderBy(s => s.FullName)
        .GroupBy(s => s.GetYear())
        .Where(g => session.SearchYear == 0 || session.SearchYear == g.Key)
        .OrderByDescending(g => g.Key);
}

@foreach(var group in groups)
{
    <details id="student_details_@group.Key">
        <summary >Cohorte @group.Key </summary>
        @foreach (var student in group)
        {
            <div>
                <a href =" @Url.Action("Details" , new { id = student.Id }) ">
                    <div style="display: flex">
                        <span class="code search"> @student.Code </span>
                        <div class="serif search"> @student.FullName </div>
                    </div>
                </a>
            </div>
        }
    </details>
}
