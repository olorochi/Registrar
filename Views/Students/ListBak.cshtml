<div id="StudentListPanel" class="StudentListLayout">
    <!-- Periodicaly refreshed -->
</div>

@section Scripts {
    <script>

        let studentListARP = null;

        $(() => {
            newSession(600);
            studentListARP =
                new AutoRefreshedPanel(
                    "StudentListPanel",
                    "/Students/GetStudents",
                    5,
                    studentListPostRefresh);

            function studentListPostRefresh() { }
        })
    </script>
}
